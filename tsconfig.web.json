{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "./src/renderer/env.d.ts",
    "./src/renderer/**/*.tsx",
    "./src/renderer/**/*.ts",
    "./src/preload/*.d.ts",
    "./src/types/index.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/*"
      ]
    }
  }
}
